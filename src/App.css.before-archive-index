/* =========================================================
   ARCHIVE SEARCH & FILTER
   ========================================================= */

.archive-filter-toolbar {
  display: grid;
  grid-template-columns: minmax(280px, 1fr) 220px 160px;
  gap: 12px;
  margin-bottom: 20px;
  padding: 14px;
  border: 1px solid #e6eaf0;
  border-radius: 14px;
  background: #f8f9fb;
}

.archive-filter-search {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
  color: #667085;
}

.archive-filter-search > svg {
  position: absolute;
  left: 14px;
  pointer-events: none;
}

.archive-filter-search input {
  width: 100%;
  min-width: 0;
  height: 44px;
  padding: 0 42px;
  border: 1px solid #d9dee7;
  border-radius: 10px;
  outline: none;
  background: #ffffff;
  color: #172033;
  font: inherit;
}

.archive-filter-search input:focus {
  border-color: #b58a2b;
  box-shadow: 0 0 0 3px rgba(181, 138, 43, 0.10);
}

.archive-filter-clear {
  position: absolute;
  right: 8px;
  width: 30px;
  height: 30px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #667085;
  font-size: 20px;
  cursor: pointer;
}

.archive-filter-select {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  border: 1px solid #d9dee7;
  border-radius: 10px;
  outline: none;
  background: #ffffff;
  color: #172033;
  font: inherit;
  cursor: pointer;
}

.archive-filter-select:focus {
  border-color: #b58a2b;
  box-shadow: 0 0 0 3px rgba(181, 138, 43, 0.10);
}

.archive-filter-empty {
  padding: 50px 24px;
}

@media (max-width: 900px) {
  .archive-filter-toolbar {
    grid-template-columns: 1fr 1fr;
  }

  .archive-filter-search {
    grid-column: 1 / -1;
  }
}

@media (max-width: 600px) {
  .archive-filter-toolbar {
    grid-template-columns: 1fr;
  }

  .archive-filter-search {
    grid-column: auto;
  }
}

