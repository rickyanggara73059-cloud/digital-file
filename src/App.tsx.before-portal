      ) : null}
    </PageLayout>
  )
}
function Documents() {
  const { caseId } = useParams()
  const { user } = useAuth()

  const [caseData, setCaseData] = useState<{
    id: string
    client_id: string
    case_number: string
    title: string
    court_id: string
    case_type_id: string
    case_subtype_id: string | null
  } | null>(null)

  const [clientName, setClientName] = useState("")
  const [courtName, setCourtName] = useState("")
  const [caseTypeName, setCaseTypeName] = useState("")
  const [subtypeName, setSubtypeName] = useState("")

  const [categories, setCategories] = useState<
    Array<{ id: string; name: string }>
  >([])

  const [documents, setDocuments] = useState<
    Array<{
      id: string
      category_id: string
      file_name: string
      file_extension: string
      file_size: number | null
      version: number
      is_current: boolean
      description: string | null
      storage_path: string
      created_at: string
    }>
  >([])

  const [loading, setLoading] = useState(true)
  const [error, setError] = useState("")

  const [showUploadModal, setShowUploadModal] = useState(false)
  const [uploadCategoryId, setUploadCategoryId] = useState("")
  const [uploadFile, setUploadFile] = useState<File | null>(null)
  const [uploadDescription, setUploadDescription] = useState("")
  const [uploading, setUploading] = useState(false)
  const [uploadError, setUploadError] = useState("")

  const [showPreview, setShowPreview] = useState(false)
  const [previewName, setPreviewName] = useState("")
  const [previewHtml, setPreviewHtml] = useState("")
  const [previewLoading, setPreviewLoading] = useState(false)
  const [previewError, setPreviewError] = useState("")

  useEffect(() => {
    async function loadCaseArchive() {
      if (!user || !caseId) {
        setLoading(false)
        return
      }

      setLoading(true)
      setError("")

      const { data: currentCase, error: caseError } = await supabase
        .from("cases")
        .select(
          "id, client_id, case_number, title, court_id, case_type_id, case_subtype_id"
        )
        .eq("id", caseId)
        .eq("lawyer_id", user.id)
        .single()

      if (caseError || !currentCase) {
        console.error(caseError)
        setError("Perkara tidak ditemukan atau tidak dapat diakses.")
        setLoading(false)
        return
      }

      setCaseData(currentCase)

      const [
        clientResult,
        courtResult,
        caseTypeResult,
        subtypeResult,
        categoriesResult,
        documentsResult,
      ] = await Promise.all([
        supabase
          .from("clients")
          .select("name")
          .eq("id", currentCase.client_id)
          .eq("lawyer_id", user.id)
          .single(),

        supabase
          .from("courts")
          .select("name")
          .eq("id", currentCase.court_id)
          .single(),

        supabase
          .from("case_types")
          .select("name")
          .eq("id", currentCase.case_type_id)
          .single(),

        currentCase.case_subtype_id
          ? supabase
              .from("case_subtypes")
              .select("name")
              .eq("id", currentCase.case_subtype_id)
              .single()
          : Promise.resolve({ data: null, error: null }),

        supabase
          .from("document_categories")
          .select("id, name")
          .order("name", { ascending: true }),

        supabase
          .from("documents")
          .select(
            "id, category_id, file_name, file_extension, file_size, version, is_current, description, storage_path, created_at"
          )
          .eq("case_id", caseId)
          .eq("lawyer_id", user.id)
          .order("created_at", { ascending: false }),
      ])

      const archiveError =
        clientResult.error ||
        courtResult.error ||
        caseTypeResult.error ||
        subtypeResult.error ||
        categoriesResult.error ||
        documentsResult.error

      if (archiveError) {
        console.error(archiveError)
        setError(
          `Gagal memuat lemari berkas: ${archiveError.message}`
        )
        setLoading(false)
        return
      }

      setClientName(clientResult.data?.name ?? "-")
      setCourtName(courtResult.data?.name ?? "-")
      setCaseTypeName(caseTypeResult.data?.name ?? "-")
      setSubtypeName(subtypeResult.data?.name ?? "")
      setCategories(categoriesResult.data ?? [])
      setDocuments(documentsResult.data ?? [])

      setLoading(false)
    }

    void loadCaseArchive()
  }, [user, caseId])

  function getCategoryDocuments(categoryId: string) {
    return documents.filter(
      (document) =>
        document.category_id === categoryId &&
        document.is_current
    )
  }

  function formatFileSize(size: number | null) {
    if (!size) return "-"

    if (size < 1024) {
      return `${size} B`
    }

    if (size < 1024 * 1024) {
      return `${(size / 1024).toFixed(1)} KB`
    }

    return `${(size / (1024 * 1024)).toFixed(1)} MB`
  }

  async function openDocument(document: {
    storage_path: string
    file_extension: string
    file_name?: string
  }) {
    const extension =
      document.file_extension.toLowerCase()

    setPreviewError("")
    setPreviewHtml("")
    setPreviewName(document.file_name ?? "Preview Dokumen")

    if (extension === "pdf") {
      const { data, error: signedUrlError } =
        await supabase.storage
          .from("case-files")
          .createSignedUrl(
            document.storage_path,
            60 * 10
          )

      if (signedUrlError || !data?.signedUrl) {
        console.error(signedUrlError)
        window.alert("Gagal membuka berkas PDF.")
        return
      }

      window.open(
        data.signedUrl,
        "_blank",
        "noopener,noreferrer"
      )

      return
    }

    if (extension === "docx") {
      setShowPreview(true)
      setPreviewLoading(true)

      try {
        const { data, error: signedUrlError } =
          await supabase.storage
            .from("case-files")
            .createSignedUrl(
              document.storage_path,
              60 * 10
            )

        if (signedUrlError || !data?.signedUrl) {
          throw (
            signedUrlError ||
            new Error("Gagal membuat link preview.")
          )
        }

        const response = await fetch(data.signedUrl)

        if (!response.ok) {
          throw new Error(
            `Gagal mengambil dokumen (${response.status}).`
          )
        }

        const arrayBuffer =
          await response.arrayBuffer()

        const result =
          await mammoth.convertToHtml({
            arrayBuffer,
          })

        setPreviewHtml(result.value)

        if (result.messages.length > 0) {
          console.warn(
            "Pesan dari Mammoth:",
            result.messages
          )
        }
      } catch (previewException) {
        console.error(previewException)

        setPreviewError(
          previewException instanceof Error
            ? previewException.message
            : "Gagal menampilkan preview dokumen."
        )
      } finally {
        setPreviewLoading(false)
      }

      return
    }

    window.alert(
      "Format DOC belum dapat dipreview langsung. Gunakan tombol Download untuk membuka dokumen."
    )
  }
  async function downloadDocument(document: {
    storage_path: string
    file_name: string
  }) {
    setError("")

    const { data, error: signedUrlError } =
      await supabase.storage
        .from("case-files")
        .createSignedUrl(document.storage_path, 60 * 10, {
          download: document.file_name,
        })

    if (signedUrlError || !data?.signedUrl) {
      console.error(signedUrlError)
      setError("Gagal membuat link download berkas.")
      return
    }

    const link = window.document.createElement("a")
    link.href = data.signedUrl
    link.download = document.file_name
    link.target = "_blank"
    link.rel = "noopener noreferrer"

    window.document.body.appendChild(link)
    link.click()
    link.remove()
  }

  async function deleteDocument(document: {
    id: string
    storage_path: string
    file_name: string
  }) {
    if (!user || !caseData) return

    const confirmed = window.confirm(
      `Hapus berkas "${document.file_name}"?\\n\\nFile akan dihapus dari lemari perkara dan Storage.`
    )

    if (!confirmed) return

    setError("")

    const { error: storageError } = await supabase.storage
      .from("case-files")
      .remove([document.storage_path])

    if (storageError) {
      console.error(storageError)
      setError(
        `Gagal menghapus file dari Storage: ${storageError.message}`
      )
      return
    }

    const { error: documentError } = await supabase
      .from("documents")
      .delete()
      .eq("id", document.id)
      .eq("case_id", caseData.id)
      .eq("lawyer_id", user.id)

    if (documentError) {
      console.error(documentError)
      setError(
        `File sudah dihapus dari Storage, tetapi data database gagal dihapus: ${documentError.message}`
      )
      return
    }

    setDocuments((current) =>
      current.filter((item) => item.id !== document.id)
    )
  }

  function openUploadModal(categoryId = "") {
    setUploadCategoryId(categoryId)
    setUploadFile(null)
    setUploadDescription("")
    setUploadError("")
    setShowUploadModal(true)
  }

  function closeUploadModal() {
    if (uploading) return

    setShowUploadModal(false)
    setUploadCategoryId("")
    setUploadFile(null)
    setUploadDescription("")
    setUploadError("")
  }

  async function handleUpload(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()

    if (!user || !caseData || !uploadFile) {
      setUploadError("Pilih file terlebih dahulu.")
      return
    }

    if (!uploadCategoryId) {
      setUploadError("Pilih kategori berkas.")
      return
    }

    const originalName = uploadFile.name
    const extension =
      originalName.split(".").pop()?.toLowerCase() ?? ""

    const allowedExtensions = ["pdf", "doc", "docx"]

    if (!allowedExtensions.includes(extension)) {
      setUploadError(
        "Format file tidak diperbolehkan. Gunakan PDF, DOC, atau DOCX."
      )
      return
    }

    const allowedMimeTypes = [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    ]

    if (
      uploadFile.type &&
      !allowedMimeTypes.includes(uploadFile.type)
    ) {
      setUploadError(
        "Jenis file tidak sesuai. Gunakan PDF, DOC, atau DOCX."
      )
      return
    }

    setUploading(true)
    setUploadError("")

    try {
      /*
       * =====================================================
       * 1. Cari semua versi dokumen dengan nama yang sama
       * =====================================================
       */

      const { data: previousDocuments, error: previousError } =
        await supabase
          .from("documents")
          .select(
            "id, version, is_current, storage_path"
          )
          .eq("case_id", caseData.id)
          .eq("category_id", uploadCategoryId)
          .eq("lawyer_id", user.id)
          .eq("file_name", originalName)
          .order("version", { ascending: false })

      if (previousError) {
        throw previousError
      }

      const nextVersion =
        previousDocuments && previousDocuments.length > 0
          ? Math.max(
              ...previousDocuments.map(
                (document) => document.version
              )
            ) + 1
          : 1

      /*
       * =====================================================
       * 2. Buat nama file Storage berdasarkan versi
       * =====================================================
       */

      const baseName = originalName.replace(
        new RegExp(`\\.${extension}$`, "i"),
        ""
      )

      const safeBaseName = baseName.replace(
        /[^a-zA-Z0-9._-]/g,
        "_"
      )

      const uniqueName =
        nextVersion === 1
          ? `${safeBaseName}.${extension}`
          : `${safeBaseName}_v${nextVersion}.${extension}`

      const storagePath = [
        user.id,
        caseData.client_id,
        caseData.id,
        uploadCategoryId,
        uniqueName,
      ].join("/")

      /*
       * =====================================================
       * 3. Upload file baru ke Storage TERLEBIH DAHULU
       *
       * Jika gagal di sini, versi lama tetap aktif.
       * =====================================================
       */

      const { error: storageError } = await supabase.storage
        .from("case-files")
        .upload(storagePath, uploadFile, {
          cacheControl: "3600",
          upsert: false,
        })

      if (storageError) {
        throw storageError
      }

      /*
       * =====================================================
       * 4. Simpan record versi baru ke database
       * =====================================================
       */

      const { data: newDocument, error: documentError } =
        await supabase
          .from("documents")
          .insert({
            lawyer_id: user.id,
            client_id: caseData.client_id,
            case_id: caseData.id,
            category_id: uploadCategoryId,
            file_name: originalName,
            storage_path: storagePath,
            file_extension: extension,
            mime_type:
              uploadFile.type ||
              "application/octet-stream",
            file_size: uploadFile.size,
            description:
              uploadDescription.trim() || null,
            version: nextVersion,
            is_current: true,
          })
          .select("id")
          .single()

      /*
       * Jika insert database gagal,
       * hapus file baru dari Storage agar tidak menjadi orphan file.
       */

      if (documentError || !newDocument) {
        await supabase.storage
          .from("case-files")
          .remove([storagePath])

        throw (
          documentError ||
          new Error("Record dokumen gagal dibuat.")
        )
      }

      /*
       * =====================================================
       * 5. Setelah versi baru sukses tersimpan,
       *    baru tandai versi lama sebagai tidak aktif.
       * =====================================================
       */

      if (previousDocuments && previousDocuments.length > 0) {
        const { error: markOldError } = await supabase
          .from("documents")
          .update({ is_current: false })
          .eq("case_id", caseData.id)
          .eq("category_id", uploadCategoryId)
          .eq("lawyer_id", user.id)
          .eq("file_name", originalName)
          .neq("id", newDocument.id)

        if (markOldError) {
          /*
           * File dan record versi baru sudah berhasil dibuat.
           * Jangan menghapus file baru hanya karena update status
           * versi lama gagal. Laporkan error agar bisa diperbaiki.
           */
          throw markOldError
        }
      }

      /*
       * =====================================================
       * 6. Refresh daftar dokumen
       * =====================================================
       */

      const { data: refreshedDocuments, error: refreshError } =
        await supabase
          .from("documents")
          .select(
            "id, category_id, file_name, file_extension, file_size, version, is_current, description, storage_path, created_at"
          )
          .eq("case_id", caseData.id)
          .eq("lawyer_id", user.id)
          .order("created_at", { ascending: false })

      if (refreshError) {
        throw refreshError
      }

      setDocuments(refreshedDocuments ?? [])
      closeUploadModal()
    } catch (uploadException) {
      console.error(uploadException)

      const message =
        uploadException instanceof Error
          ? uploadException.message
          : "Gagal mengupload berkas."

      setUploadError(message)
    } finally {
      setUploading(false)
    }
  }
  if (!caseId) {
    return (
      <PageLayout>
        <Topbar
          title="Berkas"
          eyebrow="DIGITAL CASE FILE"
        />

        <section className="page-intro">
          <p className="eyebrow">LEMARI ARSIP</p>

          <h2>Pilih perkara terlebih dahulu.</h2>

          <p>
            Buka menu Perkara lalu pilih perkara untuk melihat
            lemari berkasnya.
          </p>
        </section>

        <section className="document-card">
          <div className="empty-state">
            <div className="empty-icon">
              <BriefcaseBusiness size={30} />
            </div>

            <h4>Belum ada perkara yang dipilih</h4>

            <NavLink to="/perkara" className="primary-button">
              Buka Daftar Perkara
            </NavLink>
          </div>
        </section>
      </PageLayout>
    )
  }

  const currentDocuments = documents.filter(
    (document) => document.is_current
  )

  const allDocuments = documents

  return (
    <PageLayout>
      <Topbar
        title="Lemari Berkas"
        eyebrow="DIGITAL CASE FILE"
      />

      {loading ? (
        <section className="document-card">
          <div className="empty-state">
            <h4>Memuat lemari berkas...</h4>
          </div>
        </section>
      ) : error ? (
        <section className="document-card">
          <div className="empty-state">
            <div className="empty-icon">
              <FolderOpen size={30} />
            </div>

            <h4>Gagal memuat lemari</h4>

            <p>{error}</p>

            <NavLink to="/perkara" className="primary-button">
              Kembali ke Perkara
            </NavLink>
          </div>
        </section>
      ) : (
        <>
          <section className="case-archive-header">
            <div>
              <p className="eyebrow">LEMARI PERKARA</p>

              <h2>{clientName}</h2>

              <p className="case-archive-title">
                {caseData?.title}
              </p>
            </div>

            <div className="case-archive-meta">
              <div>
                <span>Nomor Perkara</span>
                <strong>{caseData?.case_number}</strong>
              </div>

              <div>
                <span>Pengadilan</span>
                <strong>{courtName}</strong>
              </div>

              <div>
                <span>Jenis</span>
                <strong>
                  {caseTypeName}
                  {subtypeName ? ` • ${subtypeName}` : ""}
                </strong>
              </div>
            </div>
          </section>

          <section className="page-intro archive-section-heading">
            <p className="eyebrow">KATEGORI BERKAS</p>

            <h2>Isi lemari perkara</h2>

            <p>
              Setiap kategori menjadi tempat penyimpanan berkas
              perkara yang terpisah.
            </p>
          </section>

          <section className="archive-category-grid">
            {categories.map((category) => {
              const categoryDocuments =
                getCategoryDocuments(category.id)

              return (
                <div
                  key={category.id}
                  className="archive-category-card"
                >
                  <div className="archive-category-icon">
                    <FolderOpen size={24} />
                  </div>

                  <div className="archive-category-content">
                    <h3>{category.name}</h3>

                    <p>
                      {categoryDocuments.length} berkas
                    </p>

                    {categoryDocuments.length > 0 ? (
                      <div className="archive-file-list">
                        {categoryDocuments
                          .slice(0, 3)
                          .map((document) => (
                            <div
                              key={document.id}
                              className="archive-file-item"
                            >
                              <FileText size={15} />

                              <span>{document.file_name}</span>
                            </div>
                          ))}

                        {categoryDocuments.length > 3 ? (
                          <small>
                            +
                            {categoryDocuments.length - 3} berkas
                            lainnya
                          </small>
                        ) : null}
                      </div>
                    ) : (
                      <div className="archive-empty-category">
                        Belum ada berkas
                      </div>
                    )}
                  </div>

                  <button
                    type="button"
                    className="archive-category-button"
                    onClick={() =>
                      openUploadModal(category.id)
                    }
                  >
                    Buka
                  </button>
                </div>
              )
            })}
          </section>

          <section className="document-card archive-all-files">
            <div className="document-card-header">
              <div>
                <h3>Ringkasan Berkas</h3>

                <span>
                  {currentDocuments.length} berkas aktif dalam
                  perkara ini
                </span>
              </div>

              <button
                className="primary-button"
                type="button"
                onClick={() => openUploadModal()}
              >
                <Upload size={15} />
                Upload Berkas
              </button>
            </div>

            {allDocuments.length === 0 ? (
              <div className="empty-state">
                <div className="empty-icon">
                  <FolderOpen size={30} />
                </div>

                <h4>Belum ada berkas</h4>

                <p>
                  Upload PDF, DOC, atau DOCX ke kategori yang sesuai.
                </p>

                <button
                  className="primary-button"
                  type="button"
                  onClick={() => openUploadModal()}
                >
                  <Upload size={15} />
                  Upload Berkas
                </button>
              </div>
            ) : (
              <div className="clients-table-wrap">
                <table className="clients-table">
                  <thead>
                    <tr>
                      <th>Nama Berkas</th>
                      <th>Kategori</th>
                      <th>Format</th>
                      <th>Ukuran</th>
                      <th>Versi</th>
                      <th>Aksi</th>
                    </tr>
                  </thead>

                  <tbody>
                    {allDocuments.map((document) => (
                      <tr key={document.id}>
                        <td>
                          <strong>{document.file_name}</strong>

                          {document.description ? (
                            <small>
                              {document.description}
                            </small>
                          ) : null}
                        </td>

                        <td>
                          {categories.find(
                            (category) =>
                              category.id === document.category_id
                          )?.name ?? "-"}
                        </td>

                        <td>
                          {document.file_extension.toUpperCase()}
                        </td>

                        <td>
                          {formatFileSize(document.file_size)}
                        </td>

                        <td>
                          <div className="document-version">
                            <strong>v{document.version}</strong>

                            {document.is_current ? (
                              <span className="document-version-current">
                                Aktif
                              </span>
                            ) : (
                              <span className="document-version-old">
                                Versi Lama
                              </span>
                            )}
                          </div>
                        </td>

                        <td>
                          <div className="document-actions">
                            <button
                              type="button"
                              className="document-action-button"
                              onClick={() =>
                                void openDocument(document)
                              }
                              title="Buka berkas"
                            >
                              <Eye size={14} />
                              <span>Buka</span>
                            </button>

                            <button
                              type="button"
                              className="document-action-button"
                              onClick={() =>
                                void downloadDocument(document)
                              }
                              title="Download berkas"
                            >
                              <Download size={14} />
                              <span>Download</span>
                            </button>

                            <button
                              type="button"
                              className="document-action-button document-action-danger"
                              onClick={() =>
                                void deleteDocument(document)
                              }
                              title="Hapus berkas"
                            >
                              <Trash2 size={14} />
                              <span>Hapus</span>
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          {showPreview ? (
            <div
              className="modal-backdrop document-preview-backdrop"
              onMouseDown={() => {
                if (!previewLoading) {
                  setShowPreview(false)
                }
              }}
            >
              <div
                className="document-preview-modal"
                onMouseDown={(event) =>
                  event.stopPropagation()
                }
              >
                <div className="document-preview-header">
                  <div>
                    <p className="eyebrow">PREVIEW DOKUMEN</p>
                    <h3>{previewName}</h3>
                  </div>

                  <button
                    type="button"
                    className="modal-close"
                    onClick={() =>
                      setShowPreview(false)
                    }
                    disabled={previewLoading}
                    aria-label="Tutup preview"
                  >
                    ×
                  </button>
                </div>

                <div className="document-preview-body">
                  {previewLoading ? (
                    <div className="empty-state">
                      <div className="empty-icon">
                        <FileText size={30} />
                      </div>

                      <h4>Menyiapkan preview...</h4>

                      <p>
                        Dokumen sedang diproses untuk
                        ditampilkan.
                      </p>
                    </div>
                  ) : previewError ? (
                    <div className="empty-state">
                      <div className="empty-icon">
                        <FileText size={30} />
                      </div>

                      <h4>Preview tidak tersedia</h4>

                      <p>{previewError}</p>
                    </div>
                  ) : (
                    <article
                      className="document-preview-content"
                      dangerouslySetInnerHTML={{
                        __html: previewHtml,
                      }}
                    />
                  )}
                </div>
              </div>
            </div>
          ) : null}
          {showUploadModal ? (
            <div
              className="modal-backdrop"
              onMouseDown={closeUploadModal}
            >
              <div
                className="client-modal case-modal upload-modal"
                onMouseDown={(event) =>
                  event.stopPropagation()
                }
              >
                <div className="client-modal-header">
                  <div>
                    <p className="eyebrow">ARSIP DIGITAL</p>
                    <h3>Upload Berkas</h3>
                  </div>

                  <button
                    type="button"
                    className="modal-close"
                    onClick={closeUploadModal}
                    disabled={uploading}
                    aria-label="Tutup"
                  >
                    ×
                  </button>
                </div>

                <form
                  className="client-form"
                  onSubmit={handleUpload}
                >
                  <label>
                    Kategori Berkas
                    <select
                      value={uploadCategoryId}
                      onChange={(event) =>
                        setUploadCategoryId(
                          event.target.value
                        )
                      }
                      disabled={uploading}
                    >
                      <option value="">
                        Pilih kategori berkas
                      </option>

                      {categories.map((category) => (
                        <option
                          key={category.id}
                          value={category.id}
                        >
                          {category.name}
                        </option>
                      ))}
                    </select>
                  </label>

                  <label>
                    File
                    <input
                      type="file"
                      accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                      onChange={(event) =>
                        setUploadFile(
                          event.target.files?.[0] ?? null
                        )
                      }
                      disabled={uploading}
                    />
                  </label>

                  {uploadFile ? (
                    <div className="upload-file-preview">
                      <FileText size={18} />

                      <div>
                        <strong>{uploadFile.name}</strong>

                        <small>
                          {formatFileSize(uploadFile.size)}
                        </small>
                      </div>
                    </div>
                  ) : null}

                  <label>
                    Keterangan
                    <textarea
                      placeholder="Opsional. Contoh: Bukti transfer tanggal 12 Januari 2026."
                      value={uploadDescription}
                      onChange={(event) =>
                        setUploadDescription(
                          event.target.value
                        )
                      }
                      disabled={uploading}
                      rows={4}
                    />
                  </label>

                  <div className="upload-format-info">
                    Format yang diperbolehkan:
                    <strong> PDF, DOC, DOCX</strong>
                  </div>

                  {uploadError ? (
                    <div className="client-form-error">
                      {uploadError}
                    </div>
                  ) : null}

                  <div className="client-form-actions">
                    <button
                      type="button"
                      className="secondary-button"
                      onClick={closeUploadModal}
                      disabled={uploading}
                    >
                      Batal
                    </button>

                    <button
                      type="submit"
                      className="primary-button"
                      disabled={uploading}
                    >
                      <Upload size={15} />

                      {uploading
                        ? "Mengupload..."
                        : "Upload Berkas"}
                    </button>
                  </div>
                </form>
              </div>
            </div>
          ) : null}
        </>
      )}
    </PageLayout>
  )
}
function ProtectedRoute({ children }: { children: ReactNode }) {
  const { user, loading } = useAuth()

  if (loading) {
    return <div className="auth-loading">Memuat...</div>
  }

  if (!user) {
    return <Navigate to="/login" replace />
  }

  return <>{children}</>
}

function LoginRoute() {
  const { user, loading } = useAuth()

  if (loading) {
    return <div className="auth-loading">Memuat...</div>
  }

  if (user) {
    return <Navigate to="/" replace />
  }

  return <Login />
}

function App() {
  return (
    <AuthProvider>
      <BrowserRouter>
        <Routes>
          <Route path="/login" element={<LoginRoute />} />

          <Route
            path="/"
            element={
              <ProtectedRoute>
                <Dashboard />
              </ProtectedRoute>
            }
          />

          <Route
            path="/klien"
            element={
              <ProtectedRoute>
                <Clients />
              </ProtectedRoute>
            }
          />

          <Route
            path="/perkara"
            element={
              <ProtectedRoute>
                <Cases />
              </ProtectedRoute>
            }
          />

          <Route
            path="/berkas"
            element={
              <ProtectedRoute>
                <Documents />
              </ProtectedRoute>
            }
          />

          <Route
            path="/berkas/:caseId"
            element={
              <ProtectedRoute>
                <Documents />
              </ProtectedRoute>
            }
          />

          <Route path="*" element={<Navigate to="/" replace />} />
        </Routes>
      </BrowserRouter>
    </AuthProvider>
  )
}
export default App

































