    if (insertError) {
      console.error(insertError)
      setError(insertError.message || "Gagal menyimpan perkara.")
      setSaving(false)
      return
    }

    await loadCases()

    setSaving(false)
    setShowModal(false)
    resetForm()
  }

  const getClientName = (clientId: string) =>
    clients.find((item) => item.id === clientId)?.name ?? "-"

  const getEnvironmentName = (id: string) =>
    environments.find((item) => item.id === id)?.name ?? "-"

  const getCourtTypeName = (id: string) =>
    courtTypes.find((item) => item.id === id)?.name ?? "-"

  const getCourtName = (id: string) =>
    courts.find((item) => item.id === id)?.name ?? "-"

  const getCaseTypeName = (id: string) =>
    caseTypes.find((item) => item.id === id)?.name ?? "-"

  const getSubtypeName = (id: string | null) =>
    caseSubtypes.find((item) => item.id === id)?.name ?? "-"

  const filteredCases = cases.filter((item) => {
    const keyword = search.toLowerCase().trim()

    if (!keyword) return true

    const searchableText = [
      getClientName(item.client_id),
      item.case_number,
      item.title,
      getEnvironmentName(item.judicial_environment_id),
      getCourtTypeName(item.court_type_id),
      getCourtName(item.court_id),
      getCaseTypeName(item.case_type_id),
      getSubtypeName(item.case_subtype_id),
    ]
      .join(" ")
      .toLowerCase()

    return searchableText.includes(keyword)
  })

  return (
    <PageLayout>
      <Topbar
        title="Perkara"
        eyebrow="MANAJEMEN PERKARA"
        action={
          <button className="primary-button" onClick={openAddModal}>
            + Tambah Perkara
          </button>
        }
      />

      <section className="page-intro">
        <p className="eyebrow">ARSIP PERKARA</p>

        <h2>Daftar Perkara</h2>

        <p>
          Setiap perkara menjadi tempat utama penyimpanan seluruh
          berkas klien.
        </p>
      </section>

      <section className="document-toolbar">
        <div className="document-search">
          <Search size={19} />

          <input
            type="text"
            placeholder="Cari klien, nomor perkara, pengadilan..."
            value={search}
            onChange={(event) => setSearch(event.target.value)}
          />
        </div>
      </section>

      {error && !showModal ? (
        <div className="client-form-error">{error}</div>
      ) : null}

      <section className="document-card">
        <div className="document-card-header">
          <div>
            <h3>Daftar Perkara</h3>
            <span>
              {loading
                ? "Memuat data perkara..."
