function Clients() {
  const { user } = useAuth()

  type Client = {
    id: string
    name: string
    identity_number: string | null
    phone: string | null
    email: string | null
  }

  const [clients, setClients] = useState<Client[]>([])
  const [search, setSearch] = useState("")
  const [showModal, setShowModal] = useState(false)
  const [editingClient, setEditingClient] = useState<Client | null>(null)
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [deletingId, setDeletingId] = useState<string | null>(null)
  const [error, setError] = useState("")

  const [name, setName] = useState("")
  const [identityNumber, setIdentityNumber] = useState("")
  const [phone, setPhone] = useState("")
  const [email, setEmail] = useState("")

  async function loadClients() {
    if (!user) return

    setLoading(true)
    setError("")

    const { data, error } = await supabase
      .from("clients")
      .select("id, name, identity_number, phone, email")
      .eq("lawyer_id", user.id)
      .order("created_at", { ascending: false })

    if (error) {
      console.error(error)
      setError(error.message)
      setClients([])
    } else {
      setClients(data ?? [])
    }

    setLoading(false)
  }

  useEffect(() => {
    void loadClients()
  }, [user])

  function resetForm() {
    setName("")
    setIdentityNumber("")
    setPhone("")
    setEmail("")
    setError("")
  }

  function openAddModal() {
    setEditingClient(null)
    resetForm()
    setShowModal(true)
  }

  function openEditModal(client: Client) {
    setEditingClient(client)
    setName(client.name)
    setIdentityNumber(client.identity_number ?? "")
    setPhone(client.phone ?? "")
    setEmail(client.email ?? "")
    setError("")
    setShowModal(true)
  }

  function closeModal() {
    if (saving) return

    setShowModal(false)
    setEditingClient(null)
    resetForm()
  }

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()

    if (!user) {
      setError("Sesi login tidak ditemukan.")
      return
    }

    if (!name.trim()) {
      setError("Nama lengkap wajib diisi.")
      return
    }

    setSaving(true)
    setError("")

    if (editingClient) {
      const { error } = await supabase
        .from("clients")
        .update({
          name: name.trim(),
          identity_number: identityNumber.trim() || null,
          phone: phone.trim() || null,
          email: email.trim() || null,
        })
        .eq("id", editingClient.id)
        .eq("lawyer_id", user.id)

      if (error) {
        console.error(error)
        setError(error.message)
        setSaving(false)
        return
      }
    } else {
      const { error } = await supabase.from("clients").insert({
        lawyer_id: user.id,
        name: name.trim(),
        identity_number: identityNumber.trim() || null,
        phone: phone.trim() || null,
        email: email.trim() || null,
      })

      if (error) {
        console.error(error)
        setError(error.message)
        setSaving(false)
        return
      }
    }

    await loadClients()

    setSaving(false)
    setShowModal(false)
    setEditingClient(null)
    resetForm()
  }

  async function handleDelete(client: Client) {
    if (!user) {
      setError("Sesi login tidak ditemukan.")
      return
    }

    const confirmed = window.confirm(
      `Yakin ingin menghapus klien "${client.name}"?`
    )

    if (!confirmed) return

    setDeletingId(client.id)
    setError("")

    const { error } = await supabase
      .from("clients")
      .delete()
      .eq("id", client.id)
      .eq("lawyer_id", user.id)

    if (error) {
      console.error(error)
      setError(error.message)
      setDeletingId(null)
      return
    }

    await loadClients()
    setDeletingId(null)
  }

  const filteredClients = clients.filter((client) => {
    const keyword = search.trim().toLowerCase()

    if (!keyword) return true

    return (
      client.name.toLowerCase().includes(keyword) ||
      (client.identity_number ?? "").toLowerCase().includes(keyword) ||
      (client.phone ?? "").toLowerCase().includes(keyword) ||
      (client.email ?? "").toLowerCase().includes(keyword)
    )
  })

  return (
    <PageLayout>
      <Topbar
        title="Klien"
        eyebrow="DATA KLIEN"
        action={
          <button
            type="button"
            className="primary-button"
            onClick={openAddModal}
          >
            + Tambah Klien
          </button>
        }
      />

      <section className="page-intro">
        <p className="eyebrow">LEMARI ARSIP</p>

        <h2>Daftar Klien</h2>

        <p>
          Semua klien tersimpan rapi bersama perkara dan berkas
          yang terkait.
        </p>
      </section>

      <section className="document-toolbar">
        <div className="document-search">
          <Search size={19} />

          <input
            type="text"
            value={search}
            onChange={(event) => setSearch(event.target.value)}
            placeholder="Cari nama, NIK, nomor HP, atau email..."
          />
        </div>
      </section>

      {error && !showModal && (
        <div className="client-page-error">
          {error}
        </div>
      )}

      <section className="document-card clients-card">
        <div className="document-card-header">
          <div>
            <h3>Daftar Klien</h3>
            <span>
              {loading
                ? "Memuat data..."
                : `${filteredClients.length} klien`}
            </span>
          </div>
        </div>

        {loading ? (
          <div className="empty-state">
            <h4>Memuat data klien...</h4>
          </div>
        ) : filteredClients.length === 0 ? (
          <div className="empty-state">
            <div className="empty-icon">
              <Users size={30} />
            </div>

            <h4>
              {search ? "Klien tidak ditemukan" : "Belum ada klien"}
            </h4>

            <p>
              {search
                ? "Coba gunakan kata kunci pencarian yang berbeda."
                : "Tambahkan klien pertama untuk mulai membangun lemari arsip digital Anda."}
            </p>

            {!search && (
              <button
                type="button"
                className="primary-button"
                onClick={openAddModal}
              >
                + Tambah Klien
              </button>
            )}
          </div>
        ) : (
          <div className="clients-table-wrap">
            <table className="clients-table">
              <thead>
                <tr>
                  <th>Nama Klien</th>
                  <th>NIK / Identitas</th>
                  <th>Nomor HP</th>
                  <th>Email</th>
                  <th>Aksi</th>
                </tr>
              </thead>

              <tbody>
                {filteredClients.map((client) => (
                  <tr key={client.id}>
                    <td>
                      <strong>{client.name}</strong>
                    </td>
                    <td>{client.identity_number || "—"}</td>
                    <td>{client.phone || "—"}</td>
                    <td>{client.email || "—"}</td>
                    <td>
                      <div className="client-actions">
                        <button
                          type="button"
                          className="client-action-button edit"
                          onClick={() => openEditModal(client)}
                          title="Edit klien"
                        >
                          <Pencil size={15} />
                          <span>Edit</span>
                        </button>

                        <button
                          type="button"
                          className="client-action-button delete"
                          onClick={() => void handleDelete(client)}
                          disabled={deletingId === client.id}
                          title="Hapus klien"
                        >
                          <Trash2 size={15} />
                          <span>
                            {deletingId === client.id
                              ? "Menghapus..."
                              : "Hapus"}
                          </span>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      {showModal && (
        <div className="modal-backdrop" onMouseDown={closeModal}>
          <div
            className="client-modal"
            onMouseDown={(event) => event.stopPropagation()}
          >
            <div className="client-modal-header">
              <div>
                <p className="eyebrow">DATA KLIEN</p>
                <h3>
                  {editingClient ? "Edit Klien" : "Tambah Klien"}
                </h3>
              </div>

              <button
                type="button"
                className="modal-close"
                onClick={closeModal}
                disabled={saving}
                aria-label="Tutup"
              >
                ×
              </button>
            </div>

            <form onSubmit={handleSubmit} className="client-form">
              <label>
                Nama Lengkap *
                <input
                  type="text"
                  value={name}
                  onChange={(event) => setName(event.target.value)}
                  placeholder="Masukkan nama lengkap"
                  autoFocus
                  required
                />
              </label>

              <label>
                NIK / Nomor Identitas
                <input
                  type="text"
                  value={identityNumber}
                  onChange={(event) =>
                    setIdentityNumber(event.target.value)
                  }
                  placeholder="Masukkan NIK atau nomor identitas"
                />
              </label>

              <label>
                Nomor HP
                <input
                  type="tel"
                  value={phone}
                  onChange={(event) => setPhone(event.target.value)}
                  placeholder="Contoh: 081234567890"
                />
              </label>

              <label>
                Email
                <input
                  type="email"
                  value={email}
                  onChange={(event) => setEmail(event.target.value)}
                  placeholder="Masukkan email"
                />
              </label>

              {error && (
                <div className="client-form-error" role="alert">
                  {error}
                </div>
              )}

              <div className="client-form-actions">
                <button
                  type="button"
                  className="secondary-button"
                  onClick={closeModal}
                  disabled={saving}
                >
                  Batal
                </button>

                <button
                  type="submit"
                  className="primary-button"
                  disabled={saving}
                >
                  {saving
                    ? "Menyimpan..."
                    : editingClient
                      ? "Simpan Perubahan"
                      : "Simpan Klien"}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </PageLayout>
  )
}
function Cases() {
  const { user } = useAuth()
  const navigate = useNavigate()

  const [clients, setClients] = useState<
    Array<{ id: string; name: string }>
  >([])

  const [environments, setEnvironments] = useState<
    Array<{ id: string; name: string }>
  >([])

  const [courtTypes, setCourtTypes] = useState<
    Array<{ id: string; name: string; judicial_environment_id: string }>
  >([])

  const [courts, setCourts] = useState<
    Array<{
      id: string
      name: string
      court_type_id: string
    }>
  >([])

  const [caseTypes, setCaseTypes] = useState<
    Array<{ id: string; name: string; court_type_id: string }>
  >([])

  const [caseSubtypes, setCaseSubtypes] = useState<
    Array<{ id: string; name: string; case_type_id: string }>
  >([])

  const [cases, setCases] = useState<
    Array<{
      id: string
      client_id: string
      judicial_environment_id: string
      court_type_id: string
      court_id: string
      case_type_id: string
      case_subtype_id: string | null
      case_number: string
      title: string
      status: string | null
      created_at: string
    }>
  >([])

  const [search, setSearch] = useState("")
  const [showModal, setShowModal] = useState(false)
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [error, setError] = useState("")

  const [selectedClientId, setSelectedClientId] = useState("")
  const [selectedEnvironmentId, setSelectedEnvironmentId] = useState("")
  const [selectedCourtTypeId, setSelectedCourtTypeId] = useState("")
  const [selectedCourtId, setSelectedCourtId] = useState("")
  const [selectedCaseTypeId, setSelectedCaseTypeId] = useState("")
  const [selectedSubtypeId, setSelectedSubtypeId] = useState("")
  const [caseNumber, setCaseNumber] = useState("")
  const [caseTitle, setCaseTitle] = useState("")

  useEffect(() => {
    async function loadMasterData() {
      if (!user) return

      setLoading(true)
      setError("")

      const [
        clientsResult,
        environmentsResult,
        courtTypesResult,
        courtsResult,
        caseTypesResult,
        caseSubtypesResult,
      ] = await Promise.all([
        supabase
          .from("clients")
          .select("id, name")
          .eq("lawyer_id", user.id)
          .order("name", { ascending: true }),

        supabase
          .from("judicial_environments")
          .select("id, name")
          .order("name", { ascending: true }),

        supabase
          .from("court_types")
          .select("id, name, judicial_environment_id")
          .order("name", { ascending: true }),

        supabase
          .from("courts")
          .select("id, name, court_type_id")
          .order("name", { ascending: true }),

        supabase
          .from("case_types")
          .select("id, name, court_type_id")
          .order("name", { ascending: true }),

        supabase
          .from("case_subtypes")
          .select("id, name, case_type_id")
          .order("name", { ascending: true }),
      ])

      const masterErrors = [
        ["clients", clientsResult.error],
        ["judicial_environments", environmentsResult.error],
        ["court_types", courtTypesResult.error],
        ["courts", courtsResult.error],
        ["case_types", caseTypesResult.error],
        ["case_subtypes", caseSubtypesResult.error],
      ] as const

      const failedMaster = masterErrors.find(([, error]) => error)

      if (failedMaster) {
        const [tableName, masterError] = failedMaster

        console.error(`Gagal memuat master ${tableName}:`, masterError)

        setError(
          `Gagal memuat ${tableName}: ${masterError?.message ?? "Unknown error"}`
        )

        setLoading(false)
        return
      }

      setClients(clientsResult.data ?? [])
      setEnvironments(environmentsResult.data ?? [])
      setCourtTypes(courtTypesResult.data ?? [])
      setCourts(courtsResult.data ?? [])
      setCaseTypes(caseTypesResult.data ?? [])
      setCaseSubtypes(caseSubtypesResult.data ?? [])

      setLoading(false)
    }

    void loadMasterData()
  }, [user])

  async function loadCases() {
    if (!user) return

    const { data, error: loadError } = await supabase
      .from("cases")
      .select(
        "id, client_id, judicial_environment_id, court_type_id, court_id, case_type_id, case_subtype_id, case_number, title, status, created_at"
      )
      .eq("lawyer_id", user.id)
      .order("created_at", { ascending: false })

    if (loadError) {
      console.error(loadError)
      setError("Gagal memuat daftar perkara.")
      return
    }

    setCases(data ?? [])
  }

  useEffect(() => {
    void loadCases()
  }, [user])

  const filteredCourtTypes = courtTypes.filter(
    (item) =>
      !selectedEnvironmentId ||
      item.judicial_environment_id === selectedEnvironmentId
  )

  const filteredCourts = courts.filter(
    (item) =>
      !selectedCourtTypeId ||
      item.court_type_id === selectedCourtTypeId
  )

  const filteredCaseTypes = caseTypes.filter(
    (item) =>
      !selectedCourtTypeId ||
      item.court_type_id === selectedCourtTypeId
  )

  const filteredSubtypes = caseSubtypes.filter(
    (item) =>
      !selectedCaseTypeId ||
      item.case_type_id === selectedCaseTypeId
  )

  function resetForm() {
    setSelectedClientId("")
    setSelectedEnvironmentId("")
    setSelectedCourtTypeId("")
    setSelectedCourtId("")
    setSelectedCaseTypeId("")
    setSelectedSubtypeId("")
    setCaseNumber("")
    setCaseTitle("")
    setError("")
  }

  function openAddModal() {
    resetForm()
    setShowModal(true)
  }

  function closeModal() {
    if (saving) return

    setShowModal(false)
    resetForm()
  }

  function handleEnvironmentChange(value: string) {
    setSelectedEnvironmentId(value)
    setSelectedCourtTypeId("")
    setSelectedCourtId("")
    setSelectedCaseTypeId("")
    setSelectedSubtypeId("")
  }

  function handleCourtTypeChange(value: string) {
    setSelectedCourtTypeId(value)
    setSelectedCourtId("")
    setSelectedCaseTypeId("")
    setSelectedSubtypeId("")
  }

  function handleCaseTypeChange(value: string) {
    setSelectedCaseTypeId(value)
    setSelectedSubtypeId("")
  }

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()

    if (!user) return

    if (
      !selectedClientId ||
      !selectedEnvironmentId ||
      !selectedCourtTypeId ||
      !selectedCourtId ||
      !selectedCaseTypeId ||
      !caseNumber.trim() ||
      !caseTitle.trim()
