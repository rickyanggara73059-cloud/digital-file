                >
                  <option value="">Pilih tipe pengadilan</option>
                  {filteredCourtTypes.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.name}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                Pengadilan
                <select
                  value={selectedCourtId}
                  onChange={(event) =>
                    setSelectedCourtId(event.target.value)
                  }
                  disabled={!selectedCourtTypeId || saving}
                >
                  <option value="">Pilih pengadilan</option>
                  {filteredCourts.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.name}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                Jenis Perkara
                <select
                  value={selectedCaseTypeId}
                  onChange={(event) =>
                    handleCaseTypeChange(event.target.value)
                  }
                  disabled={!selectedCourtTypeId || saving}
                >
                  <option value="">Pilih jenis perkara</option>
                  {filteredCaseTypes.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.name}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                Subjenis Perkara
                <select
