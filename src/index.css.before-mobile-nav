@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap");

:root {
  font-family: "DM Sans", sans-serif;
  color: #172033;
  background: #f5f6f8;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
}

body {
  min-width: 320px;
  background: #f5f6f8;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.app-shell {
  min-height: 100vh;
  display: flex;
}

.sidebar {
  width: 250px;
  min-height: 100vh;
  position: fixed;
  left: 0;
  top: 0;
  display: flex;
  flex-direction: column;
  padding: 28px 18px 20px;
  background: #101827;
  color: #ffffff;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 10px 34px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: #c8a45d;
  color: #101827;
}

.brand-title {
  font-family: "Manrope", sans-serif;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.brand-subtitle {
  margin-top: 3px;
  color: #9ca8ba;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.14em;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-label {
  padding: 0 12px 10px;
  color: #68758a;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 12px;
  border-radius: 9px;
  color: #aeb8c8;
  font-size: 13px;
  font-weight: 500;
  transition: 0.2s ease;
}

.nav-item:hover {
  background: #182234;
  color: #ffffff;
}

.nav-item.active {
  background: #1d293b;
  color: #ffffff;
}

.nav-item.active svg {
  color: #c8a45d;
}

.sidebar-footer {
  margin-top: auto;
  padding: 16px 10px 4px;
  border-top: 1px solid #253044;
  display: flex;
  align-items: center;
  gap: 10px;
}

.profile-avatar {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #d9c28e;
  color: #172033;
  font-size: 13px;
  font-weight: 800;
}

.sidebar-footer strong,
.topbar-profile strong {
  display: block;
  font-size: 12px;
  font-weight: 700;
}

.sidebar-footer span,
.topbar-profile span {
  display: block;
  margin-top: 2px;
  color: #8995a7;
  font-size: 10px;
}

.main-content {
  width: calc(100% - 250px);
  min-height: 100vh;
  margin-left: 250px;
  padding: 0 42px 50px;
}

.topbar {
  min-height: 92px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #e5e8ed;
}

.eyebrow {
  margin: 0 0 5px;
  color: #9b7b35;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.topbar h1 {
  margin: 0;
  font-family: "Manrope", sans-serif;
  font-size: 22px;
  letter-spacing: -0.03em;
}

.topbar-profile {
  display: flex;
  align-items: center;
  gap: 10px;
}

.welcome-section {
  min-height: 225px;
  margin-top: 30px;
  padding: 35px 38px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  border-radius: 16px;
  background: #172234;
  color: #ffffff;
}

.welcome-section .eyebrow {
  color: #d3b36e;
}

.welcome-section h2 {
  margin: 0;
  font-family: "Manrope", sans-serif;
  font-size: clamp(25px, 3vw, 36px);
  line-height: 1.18;
  letter-spacing: -0.04em;
}

.welcome-text {
  max-width: 600px;
  margin: 14px 0 0;
  color: #aeb8c8;
  font-size: 13px;
  line-height: 1.7;
}

.welcome-icon {
  width: 130px;
  height: 130px;
  display: grid;
  place-items: center;
  border: 1px solid #354257;
  border-radius: 50%;
  color: #c8a45d;
  flex-shrink: 0;
}

.search-section {
  height: 58px;
  margin-top: 25px;
  padding: 0 17px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid #e1e5eb;
  border-radius: 11px;
  background: #ffffff;
  color: #7f8b9d;
}

.search-section input {
  width: 100%;
  border: 0;
  outline: 0;
  color: #172033;
  background: transparent;
  font-size: 13px;
}

.search-section input::placeholder {
  color: #9ba5b4;
}

.search-shortcut {
  padding: 4px 8px;
  border: 1px solid #e1e5eb;
  border-radius: 5px;
  color: #9ba5b4;
  font-size: 9px;
  white-space: nowrap;
}

.stats-grid {
  margin-top: 20px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.stat-card {
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 15px;
  border: 1px solid #e5e8ed;
  border-radius: 12px;
  background: #ffffff;
}

.stat-icon {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #f3eee3;
  color: #a7833d;
}

.stat-card span {
  display: block;
  color: #7f8a9b;
  font-size: 11px;
}

.stat-card strong {
  display: block;
  margin-top: 3px;
  font-family: "Manrope", sans-serif;
  font-size: 24px;
  color: #172033;
}

.content-card {
  margin-top: 20px;
  padding: 25px;
  border: 1px solid #e5e8ed;
  border-radius: 12px;
  background: #ffffff;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-heading h3 {
  margin: 0;
  font-family: "Manrope", sans-serif;
  font-size: 18px;
}

.text-button {
  border: 0;
  background: transparent;
  color: #a17f38;
  font-size: 11px;
  font-weight: 700;
}

.empty-state {
  min-height: 240px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #f4f5f7;
  color: #9ba5b4;
}

.empty-state h4 {
  margin: 13px 0 5px;
  font-size: 14px;
}

.empty-state p {
  max-width: 380px;
  margin: 0;
  color: #8994a4;
  font-size: 11px;
  line-height: 1.6;
}

.primary-button {
  margin-top: 17px;
  padding: 10px 16px;
  border: 0;
  border-radius: 7px;
  background: #b18c45;
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
}

.primary-button:hover {
  background: #987535;
}

@media (max-width: 800px) {
  .sidebar {
    width: 70px;
    padding: 22px 10px;
  }

  .brand {
    justify-content: center;
    padding: 0 0 28px;
  }

  .brand > div:last-child,
  .nav-label,
  .nav-item span,
  .sidebar-footer > div:last-child {
    display: none;
  }

  .nav-item {
    justify-content: center;
  }

  .sidebar-footer {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
  }

  .main-content {
    width: calc(100% - 70px);
    margin-left: 70px;
    padding: 0 20px 35px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .welcome-icon {
    display: none;
  }
}

@media (max-width: 520px) {
  .topbar-profile {
    display: none;
  }

  .main-content {
    padding: 0 14px 25px;
  }

  .welcome-section {
    margin-top: 20px;
    padding: 28px 24px;
  }

  .welcome-section h2 {
    font-size: 25px;
  }

  .search-shortcut {
    display: none;
  }

  .content-card {
    padding: 20px 16px;
  }
}
.page-intro {
  margin-top: 30px;
}

.page-intro h2 {
  margin: 0;
  font-family: "Manrope", sans-serif;
  font-size: 27px;
  letter-spacing: -0.035em;
}

.page-intro p:last-child {
  margin: 8px 0 0;
  color: #8994a4;
  font-size: 12px;
  line-height: 1.6;
}

.upload-top-button {
  display: flex;
  align-items: center;
  gap: 8px;
}

.document-toolbar {
  margin-top: 24px;
  display: grid;
  grid-template-columns: 1fr 170px 190px;
  gap: 10px;
}

.document-search {
  height: 48px;
  padding: 0 15px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid #e1e5eb;
  border-radius: 9px;
  background: #ffffff;
  color: #8995a7;
}

.document-search input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: #172033;
  font-size: 12px;
}

.document-search input::placeholder {
  color: #a0a9b7;
}

.document-toolbar select {
  height: 48px;
  padding: 0 12px;
  border: 1px solid #e1e5eb;
  border-radius: 9px;
  outline: 0;
  background: #ffffff;
  color: #596579;
  font-size: 11px;
}

.document-card {
  margin-top: 18px;
  overflow: hidden;
  border: 1px solid #e3e7ed;
  border-radius: 12px;
  background: #ffffff;
}

.document-card-header {
  padding: 20px 22px;
  border-bottom: 1px solid #edf0f3;
}

.document-card-header h3 {
  margin: 0;
  font-family: "Manrope", sans-serif;
  font-size: 16px;
}

.document-card-header span {
  display: block;
  margin-top: 4px;
  color: #929cab;
  font-size: 10px;
}

.document-table {
  width: 100%;
  overflow-x: auto;
}

.document-row {
  min-width: 980px;
  display: grid;
  grid-template-columns: 2.2fr 1fr 1.15fr 1.15fr 0.7fr 0.9fr 70px;
  align-items: center;
  gap: 12px;
  padding: 15px 22px;
  border-bottom: 1px solid #edf0f3;
  color: #596579;
  font-size: 11px;
}

.document-row:last-child {
  border-bottom: 0;
}

.document-head {
  padding-top: 12px;
  padding-bottom: 12px;
  color: #9aa4b3;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.file-name {
  display: flex;
  align-items: center;
  gap: 11px;
}

.file-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 8px;
  background: #f0f2f5;
  color: #7d899a;
}

.file-icon.pdf {
  background: #f4ebe7;
  color: #a86448;
}

.file-icon.doc,
.file-icon.docx {
  background: #e9eef5;
  color: #58739b;
}

.file-name strong {
  display: block;
  max-width: 260px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #263248;
  font-size: 11px;
  font-weight: 600;
}

.file-name span {
  display: block;
  margin-top: 3px;
  color: #a0a9b6;
  font-size: 9px;
}

.category-badge {
  display: inline-block;
  padding: 5px 8px;
  border-radius: 5px;
  background: #f4f1e9;
  color: #927236;
  font-size: 9px;
  white-space: nowrap;
}

.document-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
}

.document-actions button {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #8792a3;
}

.document-actions button:hover {
  background: #f3f5f7;
  color: #a17f38;
}

@media (max-width: 800px) {
  .document-toolbar {
    grid-template-columns: 1fr;
  }

  .page-intro {
    margin-top: 22px;
  }

  .page-intro h2 {
    font-size: 23px;
  }

  .upload-top-button {
    padding: 9px 12px;
  }
}
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(8, 14, 25, 0.62);
  backdrop-filter: blur(5px);
}

.upload-modal {
  width: min(620px, 100%);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 25px 80px rgba(10, 20, 35, 0.25);
}

.modal-header {
  padding: 25px 27px 20px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid #edf0f3;
}

.modal-header h2 {
  margin: 0;
  font-family: "Manrope", sans-serif;
  font-size: 22px;
  letter-spacing: -0.03em;
}

.modal-header p:last-child {
  margin: 6px 0 0;
  color: #8994a4;
  font-size: 11px;
}

.modal-close {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border: 0;
  border-radius: 8px;
  background: #f4f5f7;
  color: #778395;
}

.modal-close:hover {
  background: #eceef1;
  color: #172033;
}

.upload-form {
  padding: 23px 27px;
}

.form-field {
  margin-bottom: 17px;
}

.form-field label {
  display: block;
  margin-bottom: 7px;
  color: #4e5b6f;
  font-size: 10px;
  font-weight: 700;
}

.form-field select {
  width: 100%;
  height: 46px;
  padding: 0 12px;
  border: 1px solid #dfe4ea;
  border-radius: 8px;
  outline: none;
  background: #ffffff;
  color: #263248;
  font-size: 11px;
}

.form-field select:focus {
  border-color: #b18c45;
  box-shadow: 0 0 0 3px rgba(177, 140, 69, 0.1);
}

.form-field select:disabled {
  cursor: not-allowed;
  background: #f5f6f8;
  color: #a0a9b6;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13px;
}

.file-dropzone {
  min-height: 170px;
  margin-top: 5px;
  padding: 25px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 1.5px dashed #cfd5dd;
  border-radius: 11px;
  background: #fafbfc;
  color: #788598;
  cursor: pointer;
  transition: 0.2s ease;
}

.file-dropzone:hover {
  border-color: #b18c45;
  background: #fcfaf5;
}

.file-dropzone.has-file {
  border-style: solid;
  border-color: #d8c79e;
  background: #fbfaf7;
}

.dropzone-icon,
.selected-file-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  margin-bottom: 10px;
  border-radius: 50%;
  background: #f2ede2;
  color: #a17f38;
}

.selected-file-icon {
  border-radius: 10px;
}

.file-dropzone strong {
  max-width: 90%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #344055;
  font-size: 12px;
}

.file-dropzone > span {
  margin-top: 5px;
  color: #9aa4b2;
  font-size: 10px;
}

.change-file-button {
  margin-top: 12px;
  padding: 6px 10px;
  border: 1px solid #ddd5c1;
  border-radius: 6px;
  background: #ffffff;
  color: #9a7838;
  font-size: 10px;
  font-weight: 700;
}

.upload-error {
  margin-top: 13px;
  padding: 11px 12px;
  display: flex;
  align-items: flex-start;
  gap: 9px;
  border: 1px solid #ead8d1;
  border-radius: 8px;
  background: #fbf4f1;
  color: #9b5c43;
  font-size: 10px;
  line-height: 1.5;
}

.upload-info {
  margin-top: 13px;
  padding: 10px 12px;
  border-radius: 7px;
  background: #f5f6f8;
  color: #8994a4;
  font-size: 9px;
  line-height: 1.5;
}

.modal-footer {
  padding: 17px 27px;
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  border-top: 1px solid #edf0f3;
  background: #fcfcfd;
}

.secondary-button {
  height: 38px;
  padding: 0 16px;
  border: 1px solid #dfe3e8;
  border-radius: 7px;
  background: #ffffff;
  color: #687487;
  font-size: 11px;
  font-weight: 700;
}

.secondary-button:hover {
  background: #f5f6f8;
}

.modal-footer .primary-button {
  height: 38px;
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 0;
}

.document-empty {
  min-height: 180px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: #9aa4b2;
}

.document-empty strong {
  color: #526075;
  font-size: 12px;
}

.document-empty span {
  font-size: 10px;
}

@media (max-width: 600px) {
  .modal-overlay {
    padding: 10px;
    align-items: flex-end;
  }

  .upload-modal {
    max-height: calc(100vh - 20px);
    border-radius: 15px 15px 8px 8px;
  }

  .modal-header,
  .upload-form,
  .modal-footer {
    padding-left: 19px;
    padding-right: 19px;
  }

  .form-grid {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .modal-footer {
    padding-bottom: 20px;
  }

  .modal-footer button {
    flex: 1;
  }
}
.field-hint {
  display: block;
  margin-top: 5px;
  color: #9aa4b2;
  font-size: 9px;
}
.topbar-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.topbar-right .primary-button {
  margin-top: 0;
  display: flex;
  align-items: center;
  gap: 7px;
}

.empty-state .primary-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  text-decoration: none;
}

.nav-item {
  border: 0;
}
 
/* =========================================================
   LOGIN PAGE
   ========================================================= */

.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
  background:
    radial-gradient(circle at 15% 20%, rgba(212, 170, 82, 0.12), transparent 28%),
    radial-gradient(circle at 85% 80%, rgba(212, 170, 82, 0.08), transparent 30%),
    #0d1728;
}

.login-card {
  width: min(100%, 460px);
  padding: 42px;
  border-radius: 24px;
  background: #ffffff;
  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.32),
    0 0 0 1px rgba(255, 255, 255, 0.08);
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 42px;
}

.login-brand-mark {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 14px;
  background: #d5ad5a;
  color: #0d1728;
}

.login-brand-title {
  color: #101b2d;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.login-brand-subtitle {
  margin-top: 3px;
  color: #8b6a2c;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.login-heading {
  margin-bottom: 30px;
}

.login-heading span {
  display: block;
  margin-bottom: 9px;
  color: #ad7d24;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.login-heading h1 {
  margin: 0;
  color: #101b2d;
  font-size: 30px;
  line-height: 1.15;
  letter-spacing: -0.025em;
}

.login-heading p {
  margin: 12px 0 0;
  color: #7a8494;
  font-size: 14px;
  line-height: 1.65;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 19px;
}

.login-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #263348;
  font-size: 13px;
  font-weight: 700;
}

.login-input {
  display: flex;
  align-items: center;
  min-height: 50px;
  padding: 0 14px;
  gap: 10px;
  border: 1px solid #dfe4eb;
  border-radius: 12px;
  background: #f9fafb;
  color: #8a96a8;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.login-input:focus-within {
  border-color: #c79b46;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(199, 155, 70, 0.12);
}

.login-input input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #172338;
  font: inherit;
  font-weight: 500;
}

.login-input input::placeholder {
  color: #a3adba;
}

.password-toggle {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  padding: 4px;
  border: 0;
  background: transparent;
  color: #8a96a8;
  cursor: pointer;
}

.password-toggle:hover {
  color: #ad7d24;
}

.login-error {
  padding: 11px 13px;
  border: 1px solid #e5b9b9;
  border-radius: 10px;
  background: #fff5f5;
  color: #a33b3b;
  font-size: 13px;
  line-height: 1.5;
}

.login-submit {
  min-height: 51px;
  margin-top: 4px;
  border: 0;
  border-radius: 12px;
  background: #172338;
  color: #ffffff;
  font: inherit;
  font-weight: 800;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.login-submit:hover {
  background: #22324c;
  box-shadow: 0 10px 24px rgba(23, 35, 56, 0.18);
  transform: translateY(-1px);
}

.login-submit:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

.login-footer {
  margin: 28px 0 0;
  padding-top: 20px;
  border-top: 1px solid #edf0f3;
  color: #9aa3af;
  font-size: 11px;
  line-height: 1.6;
  text-align: center;
}

.auth-loading {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: #0d1728;
  color: #d5ad5a;
  font-size: 14px;
  font-weight: 700;
}

@media (max-width: 520px) {
  .login-page {
    padding: 20px 14px;
  }

  .login-card {
    padding: 30px 22px;
    border-radius: 20px;
  }

  .login-brand {
    margin-bottom: 34px;
  }

  .login-heading h1 {
    font-size: 27px;
  }
}

/* =========================================================
   SIDEBAR PROFILE & LOGOUT
   ========================================================= */

.sidebar-profile {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
}

.sidebar-profile-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.sidebar-profile-info strong {
  display: block;
  max-width: 135px;
  overflow: hidden;
  color: #f5f7fa;
  font-size: 12px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-profile-info span {
  display: block;
  max-width: 150px;
  overflow: hidden;
  color: #7f8da3;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logout-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  flex-shrink: 0;
  min-height: 34px;
  padding: 0 10px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.04);
  color: #aab5c5;
  font: inherit;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.logout-button:hover {
  border-color: rgba(213, 173, 90, 0.35);
  background: rgba(213, 173, 90, 0.10);
  color: #d5ad5a;
}

.logout-button:active {
  transform: translateY(1px);
}

@media (max-width: 900px) {
  .sidebar-footer {
    gap: 10px;
  }

  .logout-button span {
    display: none;
  }

  .logout-button {
    width: 34px;
    padding: 0;
  }
}

/* =========================================================
   CLIENT MODAL
   ========================================================= */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(7, 15, 29, 0.68);
  backdrop-filter: blur(5px);
}

.client-modal {
  width: min(100%, 520px);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  padding: 30px;
  border: 1px solid #e4e8ee;
  border-radius: 20px;
  background: #ffffff;
  box-shadow: 0 28px 80px rgba(5, 15, 30, 0.28);
  animation: clientModalIn 0.18s ease-out;
}

@keyframes clientModalIn {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.client-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 26px;
}

.client-modal-header .eyebrow {
  margin: 0 0 7px;
}

.client-modal-header h3 {
  margin: 0;
  color: #101b2d;
  font-size: 24px;
  line-height: 1.2;
}

.modal-close {
  display: grid;
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  place-items: center;
  padding: 0;
  border: 1px solid #e2e6ec;
  border-radius: 9px;
  background: #ffffff;
  color: #7d899b;
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.modal-close:hover {
  border-color: #d5ad5a;
  background: #fbf8f1;
  color: #a77b29;
}

.client-form {
  display: flex;
  flex-direction: column;
  gap: 17px;
}

.client-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #263348;
  font-size: 13px;
  font-weight: 700;
}

.client-form input {
  width: 100%;
  box-sizing: border-box;
  min-height: 48px;
  padding: 0 13px;
  border: 1px solid #dce2e9;
  border-radius: 10px;
  outline: none;
  background: #f9fafb;
  color: #172338;
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.client-form input:focus {
  border-color: #c79b46;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(199, 155, 70, 0.11);
}

.client-form input::placeholder {
  color: #a3adba;
}

.client-form-error {
  padding: 11px 13px;
  border: 1px solid #e4baba;
  border-radius: 9px;
  background: #fff5f5;
  color: #a33b3b;
  font-size: 12px;
  line-height: 1.5;
}

.client-form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 7px;
  padding-top: 19px;
  border-top: 1px solid #edf0f3;
}

.secondary-button {
  min-height: 42px;
  padding: 0 17px;
  border: 1px solid #dce2e9;
  border-radius: 9px;
  background: #ffffff;
  color: #536176;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.secondary-button:hover {
  border-color: #c6ced9;
  background: #f7f8fa;
}

.secondary-button:disabled,
.primary-button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.client-form-actions .primary-button {
  min-height: 42px;
}

.client-page-error {
  margin-bottom: 16px;
  padding: 12px 15px;
  border: 1px solid #e4baba;
  border-radius: 10px;
  background: #fff5f5;
  color: #a33b3b;
  font-size: 13px;
}

.clients-table-wrap {
  width: 100%;
  overflow-x: auto;
}

.clients-table {
  width: 100%;
  border-collapse: collapse;
}

.clients-table th {
  padding: 13px 16px;
  border-bottom: 1px solid #e5e9ef;
  color: #7d899b;
  font-size: 11px;
  font-weight: 700;
  text-align: left;
  white-space: nowrap;
}

.clients-table td {
  padding: 16px;
  border-bottom: 1px solid #edf0f3;
  color: #536176;
  font-size: 13px;
  white-space: nowrap;
}

.clients-table tbody tr:last-child td {
  border-bottom: 0;
}

.clients-table tbody tr:hover {
  background: #fafbfc;
}

.clients-table td strong {
  color: #172338;
  font-weight: 700;
}

@media (max-width: 600px) {
  .modal-backdrop {
    align-items: flex-end;
    padding: 0;
  }

  .client-modal {
    width: 100%;
    max-height: 92vh;
    padding: 24px 20px;
    border-radius: 20px 20px 0 0;
  }

  .client-form-actions {
    flex-direction: column-reverse;
  }

  .client-form-actions button {
    width: 100%;
  }
}

/* =========================================================
   CLIENT ACTIONS
   ========================================================= */

.client-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.client-action-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 32px;
  padding: 0 9px;
  border-radius: 7px;
  font: inherit;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}

.client-action-button.edit {
  border: 1px solid #dce2e9;
  background: #ffffff;
  color: #66748a;
}

.client-action-button.edit:hover {
  border-color: #c79b46;
  background: #fbf8f1;
  color: #a77b29;
}

.client-action-button.delete {
  border: 1px solid #ead4d4;
  background: #ffffff;
  color: #a45a5a;
}

.client-action-button.delete:hover {
  border-color: #d99d9d;
  background: #fff5f5;
  color: #963f3f;
}

.client-action-button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

@media (max-width: 800px) {
  .client-action-button span {
    display: none;
  }

  .client-action-button {
    width: 32px;
    padding: 0;
  }
}

/* ===== CASES TABLE ===== */

.clients-table td strong,
.clients-table td small {
  display: block;
}

.clients-table td strong {
  margin-bottom: 4px;
  line-height: 1.35;
}

.clients-table td small {
  color: #8290a6;
  font-size: 12px;
  line-height: 1.35;
}

.case-status {
  display: inline-flex;
  align-items: center;
  padding: 5px 10px;
  border-radius: 999px;
  background: #f5f0e4;
  color: #9a762d;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.case-modal {
  max-width: 620px;
}

.case-modal .client-form {
  gap: 16px;
}

.case-modal .client-form label {
  gap: 7px;
}

.case-modal .client-form select,
.case-modal .client-form input {
  width: 100%;
  box-sizing: border-box;
}

@media (max-width: 700px) {
  .case-modal {
    width: calc(100% - 32px);
    max-width: none;
  }

  .clients-table {
    min-width: 900px;
  }
}

/* ===== CASE ARCHIVE ===== */

.case-row {
  cursor: pointer;
  transition: background-color 0.15s ease;
}

.case-row:hover {
  background: #faf8f2;
}

.case-archive-header {
  display: flex;
  justify-content: space-between;
  gap: 32px;
  padding: 28px 30px;
  margin-bottom: 28px;
  border: 1px solid #e2e5ea;
  border-radius: 16px;
  background: #ffffff;
}

.case-archive-header h2 {
  margin: 4px 0 6px;
  font-size: 28px;
}

.case-archive-title {
  margin: 0;
  color: #7d8aa0;
}

.case-archive-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(140px, 1fr));
  gap: 24px;
  min-width: 480px;
}

.case-archive-meta div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.case-archive-meta span {
  color: #8995a8;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.case-archive-meta strong {
  color: #12233f;
  font-size: 14px;
  line-height: 1.4;
}

.archive-section-heading {
  margin-bottom: 18px;
}

.archive-category-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 28px;
}

.archive-category-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 220px;
  padding: 22px;
  border: 1px solid #e1e5eb;
  border-radius: 16px;
  background: #ffffff;
  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease,
    border-color 0.15s ease;
}

.archive-category-card:hover {
  transform: translateY(-2px);
  border-color: #c7a35a;
  box-shadow: 0 12px 30px rgba(18, 35, 63, 0.08);
}

.archive-category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  margin-bottom: 16px;
  border-radius: 12px;
  background: #f6f1e6;
  color: #b48a3c;
}

.archive-category-content h3 {
  margin: 0 0 4px;
  color: #12233f;
  font-size: 17px;
}

.archive-category-content > p {
  margin: 0 0 14px;
  color: #8995a8;
  font-size: 13px;
}

.archive-file-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.archive-file-item {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #5e6c80;
  font-size: 12px;
}

.archive-file-item span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.archive-file-list small {
  color: #9a762d;
  font-size: 11px;
}

.archive-empty-category {
  color: #a1aaba;
  font-size: 12px;
}

.archive-category-button {
  align-self: flex-start;
  margin-top: auto;
  padding: 8px 13px;
  border: 1px solid #dfe3e9;
  border-radius: 8px;
  background: #ffffff;
  color: #233755;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.archive-category-button:hover {
  border-color: #b48a3c;
  color: #9a762d;
}

.archive-all-files {
  overflow: hidden;
}

@media (max-width: 1100px) {
  .archive-category-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .case-archive-header {
    flex-direction: column;
  }

  .case-archive-meta {
    min-width: 0;
  }
}

@media (max-width: 700px) {
  .archive-category-grid {
    grid-template-columns: 1fr;
  }

  .case-archive-meta {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .case-archive-header {
    padding: 20px;
  }

  .case-archive-header h2 {
    font-size: 24px;
  }
}

/* ===== DOCUMENT ACTIONS ===== */

.document-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

.document-action-button {
  padding: 7px 10px;
  border: 1px solid #dce1e8;
  border-radius: 7px;
  background: #ffffff;
  color: #233755;
  font: inherit;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.document-action-button:hover {
  border-color: #b48a3c;
  color: #9a762d;
}

.document-action-danger {
  color: #b54b4b;
}

.document-action-danger:hover {
  border-color: #d99a9a;
  color: #a83e3e;
}

@media (max-width: 700px) {
  .document-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .document-action-button {
    width: 100%;
  }
}

